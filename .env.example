# Shared by examples and benchmarks. Copy this file to .env at the repository root.
# Structured LLM: generation, translation, and llm_only decisions/benchmarks.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
# true: native JSON schema; false: text response, parsed and validated locally.
# Applies to generation, translation, llm_only, and Decision's LLM fallback.
LLM_STRUCTURED_OUTPUTS=true
# Blank: omit temperature/use provider default. Otherwise a number from 0 to 2.
LLM_TEMPERATURE=

# Optional Decision Model. Without its key, grading/Sense Linking use the LLM.
# decision_only benchmarks still require this provider.
DECISION_API_KEY=
DECISION_BASE_URL=https://api.typesafe.ai
DECISION_MODEL=jev-latest
# Optional override; blank uses LLM_MODEL for fallback with LLM_API_KEY / LLM_BASE_URL.
DECISION_FALLBACK_MODEL=

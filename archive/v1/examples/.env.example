# Copy to `.env` at the repo root:  cp examples/.env.example .env
# `.env` is gitignored. Settings load via the LEXI_ prefix (lexi_ai/config.py).

# --- LLM (OpenAI-compatible proxy) ---
LEXI_LLM_BASE_URL=https://api.vilao.ai/v1
LEXI_LLM_API_KEY=sk-your-api-key-here
# Model comes ONLY from here — never hardcoded in the trial scripts.
LEXI_LLM_MODEL=cd/gpt-5.6-sol
LEXI_LLM_STRUCTURED_METHOD=function_calling
LEXI_LLM_TEMPERATURE=0.1
# Extra knob read by examples/_common.py: minimal | low | medium | high
LEXI_LLM_REASONING_EFFORT=medium

# --- Data locations ---
# Generated dictionary cache (created on first run; safe to delete to reset).
LEXI_DB_URL=sqlite+aiosqlite:///./examples-lexi.db
# Read-only Cambridge source DB (the ~142MB `data` file at the repo root).
LEXI_CAMBRIDGE_DB_PATH=./data

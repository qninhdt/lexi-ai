# Local configuration and credentials
.env*
!.env.example
*.pem

# Python environments, build output and tooling caches
.venv/
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
.pytest_cache/
.ruff_cache/
.import_linter_cache/
.coverage*
/htmlcov/

# Local source snapshot uses Git LFS; distribution artifacts use GitHub Releases
/data/*
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
!/data/reference.sqlite
!/data/content.sqlite
!/data/content.sqlite.sha256

# Local planning, experiments and agent state
/plans/
/benchmark-results/
/benchmarks/*.local.json
/worktrees/
/external/
.agents/
.claude/
.codex/
.codegraph/
.DS_Store
repomix-output.*
